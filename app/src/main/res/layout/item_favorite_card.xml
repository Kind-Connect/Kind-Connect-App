<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="#DDEAD8"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/favoriteEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🍲"
            android:textSize="26sp"
            android:background="@drawable/circle_soft_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/favoriteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorite Title"
                android:textColor="#1B3D1F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/favoriteSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved item"
                android:textColor="#6E7D6A"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/favoriteAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to remove"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/favoriteImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginEnd="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>